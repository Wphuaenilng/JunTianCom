---
import "@fontsource-variable/sora";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description?: string;
  path?: string;
  type?: "website" | "article";
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href="/rss.xml"
    />
    <!-- 主题初始化：先于首帧执行；astro:after-swap 后从 localStorage 重设(swap 会重置 html 属性) -->
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem("starisle-theme");
            var prefersLight =
              window.matchMedia &&
              window.matchMedia("(prefers-color-scheme: light)").matches;
            document.documentElement.dataset.theme =
              stored || (prefersLight ? "light" : "dark");
            var accent = localStorage.getItem("starisle-accent");
            if (accent) {
              document.documentElement.dataset.accent = accent;
            } else {
              delete document.documentElement.dataset.accent;
            }
            document.documentElement.classList.add("js");
          } catch (e) {
            document.documentElement.dataset.theme = "dark";
          }
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
    <BaseHead {...props} />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // —— 导航高度 + 滚动形态(header 已持久化,只绑定一次) ——
  function initNav() {
    const nav = document.querySelector(".site-nav");
    if (!nav || (nav as HTMLElement).dataset.navBound) return;
    (nav as HTMLElement).dataset.navBound = "1";
    const setNavHeight = () =>
      document.documentElement.style.setProperty(
        "--nav-h",
        `${Math.round(nav.getBoundingClientRect().height)}px`,
      );
    setNavHeight();
    new ResizeObserver(setNavHeight).observe(nav);

    // deepseek 式导航：下滑后变形为悬浮胶囊，回顶部恢复完整长条
    const onNavScroll = () => {
      nav.classList.toggle("nav-condensed", window.scrollY > 80);
    };
    window.addEventListener("scroll", onNavScroll, { passive: true });
    onNavScroll();
  }

  // —— 滚动渐显：swap 后新页面的 .reveal 元素需要重新观察 ——
  let revealIO: IntersectionObserver | null = null;
  function initReveal() {
    revealIO?.disconnect();
    const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
    if (!revealEls.length) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      for (const el of revealEls) el.classList.add("revealed");
      return;
    }
    revealIO = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            revealIO?.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
    );
    for (const el of revealEls) revealIO.observe(el);
  }

  // —— 导航高亮：header 持久化后按当前路径重算(与 Header.astro 的 isActive 同逻辑) ——
  const NAV_HREFS = ["/", "/products", "/blog", "/learning", "/about"];
  function markNav() {
    const path = location.pathname.replace(/\/+$/, "") || "/";
    document
      .querySelectorAll(".site-nav .nav-links a, .site-nav .drawer-links a")
      .forEach((a) => {
        const href = a.getAttribute("href") ?? "";
        if (!NAV_HREFS.includes(href)) return;
        const active =
          href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
        a.classList.toggle("active", active);
      });
  }

  function initPage() {
    initNav();
    initReveal();
    markNav();
  }
  initPage();
  // ClientRouter swap 后重新初始化;astro:page-load 首次加载也会触发,initPage 幂等
  document.addEventListener("astro:page-load", initPage);

  // Astro ClientRouter 与本站重型岛组合时,视图过渡会被浏览器中止并抛出
  // 无害的 InvalidStateError(切换本身成功,仅无淡入动画)——精准静默,避免访客控制台噪音
  window.addEventListener("unhandledrejection", (e) => {
    if (String(e.reason?.message ?? "").includes("Transition was aborted")) {
      e.preventDefault();
    }
  });
  // ClientRouter swap 后重新初始化;astro:page-load 首次加载也会触发,initPage 幂等
  document.addEventListener("astro:page-load", initPage);
</script>
