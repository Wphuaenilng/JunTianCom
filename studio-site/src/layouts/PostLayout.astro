---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import { SITE } from "../data/site";
import { formatDate, readingMinutes } from "../lib/utils";
import { tagSlug } from "../lib/tags";

interface Props {
  post: CollectionEntry<"blog">;
  headings: { depth: number; slug: string; text: string }[];
  prev?: CollectionEntry<"blog"> | null;
  next?: CollectionEntry<"blog"> | null;
}

const { post, headings, prev, next } = Astro.props;
const { title, description, pubDate, category, tags, pinned } = post.data;
const minutes = readingMinutes(post.body);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const jsonld = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  author: { "@type": "Person", name: SITE.author },
  keywords: tags.join(", "),
  mainEntityOfPage: new URL(`/blog/${post.id}/`, SITE.url).href,
};
---

<Base
  title={`${title} · ${SITE.name}`}
  description={description}
  path={`/blog/${post.id}/`}
  type="article"
  jsonld={jsonld}
>
  <article>
    <header class="post-head">
      <div class="top">
        <a class="tag hot" href={`/blog/tags/${tagSlug(category)}/`}>{category}</a>
        {pinned && <span>精选 · 置顶</span>}
      </div>
      <h1>{title}</h1>
      <div class="meta">
        <span><Icon name="lucide:calendar" />{formatDate(pubDate)}</span>
        <span><Icon name="lucide:clock" />约 {minutes} 分钟</span>
        {
          tags.map((t) => (
            <a class="tag" href={`/blog/tags/${tagSlug(t)}/`}>
              #{t}
            </a>
          ))
        }
      </div>
    </header>

    <div class="with-toc">
      <article class="prose">
        <slot />
      </article>
      {
        toc.length > 1 && (
          <aside class="toc" aria-label="目录">
            <div class="toc-title">
              <Icon name="lucide:list" />
              目录
            </div>
            <ul>
              {toc.map((h) => (
                <li>
                  <a class={h.depth === 3 ? "lvl3" : undefined} href={`#${h.slug}`}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <nav class="post-footer-nav" aria-label="上下篇">
      {
        prev && (
          <a href={`/blog/${prev.id}/`}>
            <span class="dir">← 上一篇</span>
            <span class="t">{prev.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a href={`/blog/${next.id}/`} class="next">
            <span class="dir">下一篇 →</span>
            <span class="t">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
