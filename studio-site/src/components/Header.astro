---
import { Icon } from "astro-icon/components";
import HeaderActions from "./vue/HeaderActions.vue";
import { SITE, NAV } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<header class="site-nav">
  <div class="nav-inner">
    <a class="logo" href="/" aria-label={SITE.name}>
      <span class="mark"><Icon name="lucide:orbit" /></span>
      <span>{SITE.name}<small>{SITE.latin}</small></span>
    </a>
    <nav class="nav-links" aria-label="站点导航">
      {
        NAV.map((item) => (
          <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
            {item.text}
          </a>
        ))
      }
    </nav>
    <div class="nav-right">
      <a class="ic" href="/blog/" aria-label="搜索文章"><Icon name="lucide:search" /></a>
      <a class="ic" href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub">
        <Icon name="lucide:github" />
      </a>
      <a class="btn primary contact-btn" href="/about/#coop">联系我</a>
      <HeaderActions client:load nav={[...NAV]} path={Astro.url.pathname} />
    </div>
  </div>
</header>
