---
/**
 * 后台独立骨架 —— 继承官网品牌语言(深海军蓝 × 靛青渐变 × Sora)。
 * 不使用站点 Base 布局；仅 dev 注入时可达。
 * ClientRouter:菜单切换走视图过渡(swap),侧栏/弹窗层持久化,不再整页刷新。
 */
import "@fontsource-variable/sora";
import "../styles/tokens.css";
import "../styles/admin.css";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  desc?: string;
  active: string;
}
const { title, desc, active } = Astro.props;

const NAV_GROUPS: { label: string; items: [string, string, string][] }[] = [
  {
    label: "内容",
    items: [
      ["/admin/checkins", "打卡记录", "flame"],
      ["/admin/notes", "学习周记", "notebook-pen"],
      ["/admin/posts", "博客文章", "newspaper"],
      ["/admin/products", "产品展示", "package"],
    ],
  },
  {
    label: "配置",
    items: [
      ["/admin/roadmap", "路线进度", "map"],
      ["/admin/settings", "站点配置", "settings-2"],
    ],
  },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/admin";
const isActive = (href: string) =>
  href === "/admin" ? path === "/admin" : path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · 站点后台</title>
    <ClientRouter />
    <script is:inline data-astro-rerun>
      // 与官网共用主题键,首帧前设定避免闪烁;data-astro-rerun 保证每次 swap 后重设
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("starisle-theme") ?? "dark";
      } catch {}
    </script>
  </head>
  <body class="admin">
    <aside class="admin-sidebar" transition:persist>
      <div class="admin-brand">
        <span class="admin-brand-mark"><Icon name="lucide:orbit" size={17} /></span>
        <div>
          <b>星屿后台</b>
          <small>STARISLE ADMIN</small>
        </div>
      </div>
      <nav class="admin-nav">
        {
          NAV_GROUPS.map((group) => (
            <>
              <div class="admin-nav-label">{group.label}</div>
              {group.items.map(([href, label, icon]) => (
                <a href={href} class:list={[{ active: isActive(href) }]}>
                  <Icon name={`lucide:${icon}`} size={15} />
                  {label}
                </a>
              ))}
            </>
          ))
        }
      </nav>
      <div class="admin-foot">
        <button class="admin-theme-btn" id="admin-theme-toggle" type="button" title="切换明暗主题" aria-label="切换明暗主题">
          <span class="ic-moon"><Icon name="lucide:moon" size={15} /></span>
          <span class="ic-sun"><Icon name="lucide:sun" size={15} /></span>
        </button>
        <a class="admin-back" href="/" target="_blank">
          <Icon name="lucide:external-link" size={13} />
          打开官网
        </a>
      </div>
    </aside>

    <main>
      <header class="admin-pagehead">
        <div>
          <h1>{title}</h1>
          {desc && <p>{desc}</p>}
        </div>
        <slot name="actions" />
      </header>
      <slot />
    </main>

    <div class="admin-toast-wrap" id="admin-toasts" transition:persist></div>
  </body>
</html>

<style>
  .admin-foot { margin-top: auto; display: flex; align-items: center; gap: 8px; }
  .admin-foot .admin-back { margin: 0; flex: 1; }
  /* 图标随主题切换:暗色显示月亮(可切亮),亮色显示太阳(可切暗) */
  .ic-sun { display: none; }
  :global(html[data-theme="light"]) .ic-sun { display: inline-flex; }
  :global(html[data-theme="light"]) .ic-moon { display: none; }
</style>

<script>
  // 轻量 toast：window.adminToast(message, "ok" | "err")
  function adminToast(message: string, type: "ok" | "err" = "ok") {
    const wrap = document.getElementById("admin-toasts");
    if (!wrap) return;
    const el = document.createElement("div");
    el.className = `admin-toast ${type}`;
    el.textContent = message;
    wrap.appendChild(el);
    setTimeout(() => {
      el.classList.add("out");
      setTimeout(() => el.remove(), 260);
    }, 2800);
  }
  (window as unknown as Record<string, unknown>).adminToast = adminToast;

  // 明暗主题切换(侧栏已持久化,绑定一次即可;与官网共用 localStorage 键)
  function bindThemeToggle() {
    const btn = document.getElementById("admin-theme-toggle");
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", () => {
      const html = document.documentElement;
      const next = html.dataset.theme === "light" ? "dark" : "light";
      html.dataset.theme = next;
      try {
        localStorage.setItem("starisle-theme", next);
      } catch {}
    });
  }

  // 侧栏持久化后,选中态在每次 swap 后按当前路径重算
  function markActive() {
    const path = location.pathname.replace(/\/+$/, "") || "/admin";
    document.querySelectorAll(".admin-nav a").forEach((a) => {
      const href = a.getAttribute("href") ?? "";
      const active =
        href === "/admin" ? path === "/admin" : path === href || path.startsWith(`${href}/`);
      a.classList.toggle("active", active);
    });
  }

  function initChrome() {
    bindThemeToggle();
    markActive();
  }
  initChrome();
  // ClientRouter swap 后重新初始化;astro:page-load 首次加载也会触发,initChrome 幂等
  document.addEventListener("astro:page-load", initChrome);

  // 同官网:精准静默 VT 中断的无害报错(切换成功,仅无淡入动画)
  window.addEventListener("unhandledrejection", (e) => {
    if (String(e.reason?.message ?? "").includes("Transition was aborted")) {
      e.preventDefault();
    }
  });
</script>
