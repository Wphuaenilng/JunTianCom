---
import AdminLayout from "../AdminLayout.astro";
import { execFileSync } from "node:child_process";
import { DIRS, REPO_ROOT, listEntries, readJSON } from "../lib/store.js";

const checkins = readJSON<{ checkins: { date: string; topics: string[] }[] }>(
  "src/data/checkins.json",
);
const notes = listEntries(DIRS.learning);
const posts = listEntries(DIRS.blog);
const products = listEntries(DIRS.products);
const draftCount = posts.filter((p) => p.data.draft === true).length;

function gitStatus(): { dirty: number; branch: string } {
  try {
    const out = execFileSync(
      "git",
      ["status", "--porcelain", "--", "studio-site/src/data", "studio-site/src/content"],
      { cwd: REPO_ROOT },
    ).toString().trim();
    const branch = execFileSync("git", ["rev-parse", "--abbrev-ref", "HEAD"], {
      cwd: REPO_ROOT,
    }).toString().trim();
    return { dirty: out ? out.split("\n").length : 0, branch };
  } catch {
    return { dirty: -1, branch: "?" };
  }
}
const { dirty, branch } = gitStatus();
---

<AdminLayout
  title="仪表盘"
  active="/admin"
  desc="内容资产一览 · 修改不会自动提交 git,确认后一键同步"
>
  <div class="stat-grid">
    <div class="stat"><b>{checkins.checkins.length}</b><span>打卡天数</span></div>
    <div class="stat"><b>{notes.length}</b><span>学习周记</span></div>
    <div class="stat"><b>{posts.length}</b><span>博客文章（草稿 {draftCount}）</span></div>
    <div class="stat"><b>{products.length}</b><span>产品条目</span></div>
  </div>

  <div class="card">
    <h2>git 同步</h2>
    <p class="muted">
      分支 {branch} · 数据与内容目录中 {dirty < 0 ? "状态未知（git 不可用）" : dirty === 0 ? "没有待提交的变更" : `${dirty} 个文件待提交`}
    </p>
    <button class="btn btn-shine" id="sync" type="button">提交并推送</button>
  </div>

  <div class="card">
    <h2>使用提示</h2>
    <p class="muted">
      后台仅存在于 npm run dev;编辑保存后,开着官网的页面会即时热更新。改动不自动进 git,确认无误后点「提交并推送」(或自行 git push)。
    </p>
  </div>
</AdminLayout>

<style>
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 18px; }
  .stat-grid .stat { margin-bottom: 0; }
  .stat { background: var(--adm-card); border: 1px solid var(--adm-border); border-radius: var(--adm-radius); padding: 16px 18px; animation: admFadeUp 0.45s cubic-bezier(0.22, 0.8, 0.36, 1) both; }
  .stat:nth-child(2) { animation-delay: 0.06s; }
  .stat:nth-child(3) { animation-delay: 0.12s; }
  .stat:nth-child(4) { animation-delay: 0.18s; }
  .stat::after { content: ""; position: absolute; right: -24px; top: -24px; width: 96px; height: 96px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--primary) 20%, transparent), transparent 70%); pointer-events: none; }
  .stat { position: relative; overflow: hidden; }
  .stat b { font-family: var(--font-display); font-size: 30px; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .stat span { display: block; color: var(--adm-muted); font-size: 12px; margin-top: 2px; }
</style>

<script>
  // ClientRouter swap 后模块脚本不会重复执行,用 astro:page-load 重新绑定(幂等)
  function bindSync() {
    const btn = document.getElementById("sync") as HTMLButtonElement | null;
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "1";
    const toast = (window as unknown as { adminToast?: (m: string, t?: "ok" | "err") => void })
      .adminToast;
    btn.addEventListener("click", async () => {
      btn.disabled = true;
      btn.textContent = "同步中…";
      try {
        const res = await fetch("/api/admin/git-sync", { method: "POST" });
        const data = (await res.json()) as { ok: boolean; message: string };
        toast?.(data.message, data.ok ? "ok" : "err");
      } catch {
        toast?.("请求失败", "err");
      }
      btn.disabled = false;
      btn.textContent = "提交并推送";
    });
  }
  bindSync();
  document.addEventListener("astro:page-load", bindSync);
</script>
