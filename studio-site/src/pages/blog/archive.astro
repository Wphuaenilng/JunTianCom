---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/utils";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.pubDate.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<Base
  title={`归档 · 星屿工作室`}
  description={`全部文章按年月归档，共 ${posts.length} 篇。`}
  path="/blog/archive/"
>
  <div class="page-head">
    <h1>归档</h1>
    <p>全部文章按年月归档，共 {posts.length} 篇。</p>
  </div>

  <section class="section" style="padding-top:20px;max-width:860px">
    {
      years.map(([year, list]) => (
        <div>
          <div class="sub-head" style="margin-top:28px">{year} 年</div>
          <div class="side-card" style="padding:6px 20px">
            {list.map((p) => (
              <a
                class="row"
                href={`/blog/${p.id}/`}
                style="display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px dashed var(--border)"
              >
                <span style="color:var(--muted);white-space:nowrap">{formatDate(p.data.pubDate)}</span>
                <span style="color:var(--text);text-align:right">{p.data.title}</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>
